.full{width:100%;margin-top:24rpx}.switch{color:#245e81;text-align:center;font-size:23rpx;font-weight:740;padding:24rpx 0 3rpx}.profile-head{display:flex;align-items:center;gap:22rpx;border-top:5rpx solid #a6cbdc}.avatar{width:88rpx;height:88rpx;border-radius:22rpx;background:#e1f0f7;color:#204f75;font-size:34rpx;font-weight:850;display:flex;align-items:center;justify-content:center;flex:none}.user-name{font-size:31rpx;font-weight:800;color:#17395e}.field-grid{display:flex;gap:18rpx}.field-grid .field{flex:1;min-width:0}
.account-brand{display:flex;align-items:center;gap:18rpx;margin-bottom:18rpx;padding:21rpx 26rpx;border-radius:25rpx;background:linear-gradient(125deg,#0d2b54,#1b466f);box-shadow:0 16rpx 33rpx rgba(13,42,82,.14)}.account-logo{width:116rpx;height:116rpx;border:1rpx solid rgba(255,255,255,.16);border-radius:18rpx;flex:none}.account-brand .eyebrow{color:#b9d9e8}.account-brand .title{margin:3rpx 0;color:#fff}
.agree{display:flex;align-items:flex-start;gap:8rpx;color:#355573;font-size:23rpx;line-height:1.5;margin:24rpx 0 8rpx}
.account-filing{display:flex;flex-direction:column;align-items:center;gap:5rpx;margin-top:46rpx;padding:21rpx 12rpx 0;border-top:1rpx solid #dce7ef;color:#61798d;font-size:23rpx;line-height:1.55;text-align:center}
.account-filing-name{color:#526e85;font-weight:650}
