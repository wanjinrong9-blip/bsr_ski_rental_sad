.order-card{padding:27rpx;border-left:6rpx solid #a4c9db}.order-code{font-size:25rpx;font-weight:850;color:#17456f;letter-spacing:1rpx}.order-store{font-size:29rpx;font-weight:780;margin:18rpx 0;color:#102d52}.time-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;background:#edf5f9;border-radius:14rpx;padding:16rpx}.time-cell{display:flex;flex-direction:column;gap:6rpx;min-width:0}.time-label{font-size:21rpx;color:#52728a}.time-value{font-size:24rpx;font-weight:670;color:#1c456b;overflow-wrap:anywhere}.stage{flex:1;min-width:0}.handler{font-size:23rpx;color:#375d7a;margin:7rpx 0}.order-open{text-align:right;color:#245f84;font-size:22rpx;font-weight:740;margin-top:18rpx}
