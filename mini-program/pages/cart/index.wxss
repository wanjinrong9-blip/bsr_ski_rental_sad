.cart-line{padding:24rpx}.gear-name{font-size:28rpx;font-weight:800;line-height:1.4;color:#16385d}.cart-line .muted{margin-top:4rpx}.cart-line-controls{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-top:19rpx}.cart-line-facts{color:#58748b;font-size:22rpx;line-height:1.5;min-width:0}.quantity{display:flex;align-items:center;width:238rpx;height:72rpx;border:1rpx solid #d5e4ee;border-radius:13rpx;overflow:hidden;flex:none}.quantity-btn{display:block;flex:0 0 76rpx;width:76rpx;min-width:76rpx;height:72rpx;margin:0;background:#eaf3f8;color:#1c567c;font-size:29rpx;line-height:72rpx;padding:0;border-radius:0}.quantity-count{flex:1;text-align:center;font-size:25rpx;font-weight:750;color:#15395f}
.quote-card{border-top:5rpx solid #a6cbdc}.price-row{display:flex;align-items:center;justify-content:space-between;margin:15rpx 0;color:#536f87;font-size:24rpx;gap:12rpx}.price-value{font-weight:760;color:#183c60;white-space:nowrap}.price-row.total{font-size:29rpx;color:#102d52;font-weight:800;background:#e8f2f7;border-radius:12rpx;padding:14rpx;margin:16rpx 0}.price-row.total .price-value{font-size:32rpx;color:#103b65}
.policy-summary{display:flex;align-items:center;justify-content:space-between;font-weight:750;margin:22rpx 0 12rpx}.card .btn-ghost{margin-top:20rpx;width:100%}.checkout,.retry{width:100%;margin-top:17rpx}
.overlay{position:fixed;inset:0;background:rgba(13,42,82,.54);z-index:20;display:flex;align-items:flex-end}.policy-dialog{background:#fff;border-top:8rpx solid #12375f;border-radius:30rpx 30rpx 0 0;width:100%;padding:28rpx 28rpx 55rpx;max-height:88vh}.policy-head{align-items:flex-start}.policy-head .card-title{margin-top:6rpx}.close{font-size:48rpx;line-height:1;color:#6c879c;padding:0 12rpx}.policy-scroll{height:46vh;border:1rpx solid #dbe7ef;border-radius:18rpx;padding:0 18rpx;background:#f8fbfd;margin:17rpx 0}.policy-section-title{font-size:26rpx;font-weight:800;color:#153a60;margin:25rpx 0 15rpx}.grade{border-bottom:1rpx solid #e0eaf1;padding:14rpx 0}.grade .muted,.grade .tiny{display:block;margin-top:8rpx}.step{display:flex;gap:15rpx;line-height:1.55;color:#42617a;margin-bottom:18rpx;font-size:23rpx}.step-num{flex:none;border-radius:999rpx;background:#dcecf5;color:#245f84;width:36rpx;height:36rpx;text-align:center;font-size:20rpx;line-height:36rpx;font-weight:800}.policy-end{padding:18rpx;background:#e8f2f7;text-align:center;color:#235d7e;border-radius:14rpx;margin:25rpx 0}.agree{display:flex;align-items:flex-start;gap:6rpx;font-size:23rpx;line-height:1.5;margin:18rpx 0}.agree-copy{flex:1}

.policy-dialog{overflow-y:auto}
