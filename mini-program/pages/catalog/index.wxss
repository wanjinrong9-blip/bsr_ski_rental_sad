.hero{position:relative;overflow:hidden;background:linear-gradient(135deg,#0d2b54 0%,#173d69 68%,#24577b 100%);border-radius:26rpx;padding:34rpx 38rpx 66rpx;color:#fff;min-height:360rpx;box-shadow:0 19rpx 37rpx rgba(13,42,82,.16)}
.hero-logo{display:block;width:126rpx;height:126rpx;border:1rpx solid rgba(255,255,255,.18);border-radius:19rpx;margin-bottom:8rpx;position:relative;z-index:1}
.eyebrow.light{color:#b8d9ea;position:relative;z-index:1}
.hero-title{font-size:50rpx;font-weight:850;line-height:1.25;position:relative;z-index:1;margin:13rpx 0}
.hero-caption{font-size:24rpx;max-width:440rpx;color:#d7e9f3;position:relative;z-index:1;line-height:1.5}
.mountains{position:absolute;inset:0;opacity:.14;pointer-events:none}.peak{position:absolute;width:0;height:0;border-left:180rpx solid transparent;border-right:180rpx solid transparent;border-bottom:245rpx solid #c9e2ee;right:-42rpx;bottom:-20rpx}.peak-back{right:140rpx;bottom:-75rpx;transform:scale(.75);opacity:.6}.snowline{position:absolute;right:-20rpx;bottom:32rpx;width:440rpx;height:2rpx;background:#fff;transform:rotate(-8deg)}
.booking{position:relative;margin-top:-25rpx;z-index:1;border-top:5rpx solid #a6cbdc}.section-title.compact{margin:0 0 14rpx}.dates{display:flex;gap:15rpx}.dates .field{flex:1;min-width:0}.dates .field-control{font-size:24rpx;padding:19rpx 12rpx}.booking .btn{width:100%}.booking-foot{margin-top:15rpx}
.filters{white-space:nowrap;margin-bottom:20rpx}.filter-row{display:flex;gap:12rpx;padding-bottom:4rpx}.filter{flex:none;border-radius:999rpx;border:1rpx solid #cfdfea;background:#fff;color:#4b6883;padding:12rpx 20rpx;font-size:23rpx}.filter.selected{background:#12375f;border-color:#12375f;color:#fff;font-weight:750}
.facet-row{display:flex;gap:14rpx;margin:0 0 22rpx}.facet{flex:1;min-width:0;background:#fff;border:1rpx solid #d6e4ed;border-radius:16rpx;padding:10rpx 16rpx}.facet-label{display:block;color:#607b91;font-size:20rpx}.facet-value{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#173a60;font-size:24rpx;font-weight:750;padding:3rpx 0}
.gear-card{margin-bottom:17rpx}.gear-top{display:flex;align-items:center;gap:17rpx}.gear-symbol{height:85rpx;width:85rpx;background:linear-gradient(145deg,#eef6fa,#dcecf4);display:flex;align-items:center;justify-content:center;border-radius:20rpx;color:#245c81;font-size:24rpx;font-weight:800;flex:none}.gear-info{flex:1;min-width:0}.gear-name{font-size:28rpx;font-weight:800;line-height:1.35;color:#16385d}.gear-top .pill{flex:none}.gear-card .line{margin:18rpx 0}.cart-float{position:fixed;right:30rpx;bottom:130rpx;background:#0d2b54;color:#fff;border-radius:999rpx;padding:18rpx 22rpx;box-shadow:0 12rpx 30rpx rgba(13,42,82,.25);z-index:5;font-size:24rpx;font-weight:750}.cart-badge{display:inline-block;background:#d8a575;color:#372d27;border-radius:999rpx;padding:0 10rpx;margin-left:12rpx;min-width:28rpx;text-align:center}
