<view class="page">
  <view class="brand-mini"><image class="brand-mini-logo" src="/assets/bsr-logo.png" mode="aspectFill" aria-label="BSR 标志"/><text>BSR · SKARDALEN</text></view>
  <view class="loading" wx:if="{{loading}}">正在同步订单进度…</view>
  <view class="card" wx:elif="{{error}}"><view class="notice notice-error">{{error}}</view><button class="btn btn-ghost" bindtap="refresh">重新同步订单</button></view>
  <view wx:elif="{{order}}">
    <view class="eyebrow">RESERVATION {{order.code}}</view><view class="title">订单详情</view>
    <view class="row heading-row"><text class="pill {{order.status === 'EXPIRED' || order.status === 'SETTLEMENT' ? 'pill-warm' : ''}}">{{statusLabel}}</text><text class="tiny">{{order.store_name}}</text></view>
    <view class="simulation">{{wechatMode ? '安全合成展示' : '本机课程演示'}}：签署、付款、退款和补差记录均为模拟，不构成真实交易或有效电子签章。</view>
    <view class="notice notice-warn" wx:if="{{order.status === 'EXPIRED'}}">15 分钟预约暂留已到期，库存已释放。请返回选装备页面重新核对日期和价格。</view>

    <view class="card"><view class="card-title">当前进度</view>
      <view class="current-step"><view class="eyebrow">NOW IN PROGRESS</view><view class="current-name">{{order.workflow.current}}</view><view class="muted">负责人：{{currentHandler}}</view><view class="muted" wx:if="{{currentTime}}">{{currentTime}} · Europe/Oslo</view><view class="muted" wx:if="{{order.status === 'HOLD'}}">预约暂留截止：{{holdText}} · Europe/Oslo</view></view>
      <view class="timeline"><view class="step {{item.status === 'DONE' ? 'done' : item.status === 'CURRENT' ? 'current' : ''}}" wx:for="{{steps}}" wx:key="key"><view class="dot"></view><view class="step-body"><view class="row"><text class="step-label">{{item.label}}</text><text class="tiny">{{item.statusText}}</text></view><view class="tiny">处理人：{{item.handlerText}}<text wx:if="{{item.timeText}}"> · {{item.timeText}}</text></view></view></view></view>
    </view>

    <view class="card"><view class="card-title">取还信息</view><view class="detail-row"><text>取货</text><text class="detail-value">{{pickupText}}</text></view><view class="detail-row"><text>最迟归还</text><text class="detail-value">{{returnText}}</text></view><view class="detail-row"><text>取货门店</text><text class="detail-value">{{order.store_name}}</text></view><view class="line"></view><view class="tiny">到店取货码 · 订单确认后有效</view><view class="pickup-code">{{order.status === 'HOLD' || order.status === 'EXPIRED' || order.status === 'CANCELLED' ? '等待确认' : order.pickup_code}}</view><view class="tiny">向门店租赁专员出示取货码，现场逐件验货后取走。</view></view>

    <view class="card"><view class="card-title">装备与费用 · NOK</view>
      <view class="detail-row" wx:for="{{order.lines}}" wx:key="id"><text>{{item.name}} · {{item.size}} ×{{item.qty}}</text><text class="detail-value">NOK {{item.unit_rent_nok * item.qty}}</text></view>
      <view class="line"></view><view class="detail-row"><text>租金</text><text class="detail-value">NOK {{order.rent_nok}}</text></view><view class="detail-row"><text>可退押金</text><text class="detail-value">NOK {{order.deposit_nok}}</text></view><view class="detail-row total"><text>合计</text><text class="detail-value">NOK {{order.total_nok}}</text></view><view class="tiny">新订单押金按每件参考价值的 8% 快照计算；实际费用以订单政策版本为准。</view>
    </view>

    <view class="card" wx:if="{{order.preparation}}"><view class="row"><view class="card-title">装备准备</view><text class="pill">{{order.preparation.label}}</text></view><view class="muted">{{order.preparation.public_note || '门店正在安排处理'}} · 顾客与店员可查看相同进度。</view><view class="line"></view><view class="prep-event" wx:for="{{prepEvents}}" wx:key="id"><view class="event-mark"></view><view><view class="event-title">{{item.status}} · {{item.actor_name || '待分派'}}</view><view class="tiny">{{item.note}} · {{item.timeText}}</view></view></view></view>

    <view class="card" wx:if="{{damageCases.length || order.damage.settlement}}">
      <view class="card-title">受损鉴定与押金</view>
      <view class="notice notice-warn" wx:if="{{damageCases.length}}">疑似受损时押金暂缓退还。技师须在归还后 24 小时内反馈，店员核对资料、经理核价后才结算。</view>
      <view class="damage-case" wx:for="{{damageCases}}" wx:key="id">
        <view class="row"><text class="damage-name">{{item.inventory_no}} · {{item.gradeLabel}}</text><text class="pill">{{item.statusLabel}}</text></view>
        <view class="tiny">受损部位：{{item.part || '等待技师鉴定'}} · 照片证据 {{item.photoCount}} 张</view>
        <view class="photo-list" wx:if="{{item.photos.length}}">
          <button class="photo-button" wx:for="{{item.photos}}" wx:for-item="photo" wx:key="id"
            data-photo-id="{{photo.id}}" disabled="{{acting}}" bindtap="onPreviewDamagePhoto">
            查看 {{photo.part}} · {{photo.caption}}
          </button>
        </view>
        <view class="tiny">24 小时反馈期限：{{item.dueText}}<text wx:if="{{item.feedbackText}}"> · 初评 {{item.feedbackText}}</text></view>
        <view class="tiny" wx:if="{{item.assessor_name}}">负责技师：{{item.assessor_name}}</view>
        <view class="damage-diagnosis" wx:if="{{item.diagnosis}}">鉴定依据：{{item.diagnosis}}</view>
        <view class="tiny" wx:if="{{item.reviewText}}">经理复核：{{item.reviewText}}<text wx:if="{{item.review_note}}"> · {{item.review_note}}</text></view>
        <view class="detail-row" wx:if="{{item.status === 'APPROVED'}}"><text>核定受损费</text><text class="detail-value">NOK {{item.fee_nok}}</text></view>
      </view>
      <view wx:if="{{order.damage.settlement}}">
        <view class="line"></view>
        <view class="detail-row"><text>受损费</text><text class="detail-value">NOK {{order.damage.settlement.damage_fee_nok}}</text></view>
        <view class="detail-row"><text>超时费</text><text class="detail-value">NOK {{order.damage.settlement.late_fee_nok}}</text></view>
        <view class="detail-row"><text>已抵扣押金</text><text class="detail-value">NOK {{order.damage.settlement.deducted_nok}}</text></view>
        <view class="detail-row"><text>可退押金</text><text class="detail-value">NOK {{order.damage.settlement.refund_nok}}</text></view>
        <view class="detail-row"><text>需联系补差</text><text class="detail-value">NOK {{order.damage.settlement.supplement_nok}}</text></view>
        <view class="detail-row" wx:if="{{order.damage.settlement.supplement_nok}}"><text>已核实登记补差</text><text class="detail-value">NOK {{order.damage.settlement.paid_nok}}</text></view>
        <view class="tiny">付款、退款及补差均为课程模拟，不发生真实资金转移；超出押金部分须由门店先联系顾客。</view>
      </view>
      <view class="damage-contacts" wx:if="{{damageContacts.length}}"><view class="line"></view><view class="tiny">门店沟通记录</view>
        <view class="tiny" wx:for="{{damageContacts}}" wx:key="id">{{item.timeText}} · {{item.outcomeText}} · {{item.note}}</view>
      </view>
      <view wx:if="{{canDispute}}"><view class="line"></view><view class="card-title">提出费用异议</view><view class="notice notice-warn" wx:if="{{order.damage.disputeActive}}">本人异议已记录，等待原门店联系核对；异议解决前暂停最终结清。</view><view wx:if="{{!order.damage.disputeActive || disputePending}}"><view class="muted">可说明对鉴定、费用或补差的疑问。提交后由原门店联系核对；这不会确认退款到账。</view><textarea class="field-control dispute-note" maxlength="2000" value="{{disputeNote}}" disabled="{{acting || disputePending}}" placeholder="请填写5–2000字的异议说明" bindinput="onDisputeInput"/><view class="notice notice-error" wx:if="{{disputeError}}">{{disputeError}}</view><button class="btn" disabled="{{acting}}" loading="{{acting}}" bindtap="onSubmitDispute">{{disputePending ? '用原提交标识重试异议' : '提交本人异议'}}</button></view></view>
    </view>

    <view class="card"><view class="card-title">1 · 合同确认</view><view class="muted" wx:if="{{contract}}">{{contract.code}} · V{{contract.version}} · {{contract.signed_at ? '已记录本人确认' : '待阅读确认'}}</view><view class="tiny" wx:if="{{signedText}}">确认时间：{{signedText}} · Europe/Oslo</view><view class="muted" wx:if="{{!contract}}">待生成当前版本合同。</view><view class="notice notice-error" wx:if="{{contractError}}">{{contractError}}</view><view class="action-stack"><button class="btn" wx:if="{{canIssue}}" disabled="{{acting}}" bindtap="onIssueContract">生成并阅读合同</button><button class="btn" wx:if="{{canSign}}" disabled="{{acting}}" bindtap="openContract">阅读并确认合同</button><button class="btn btn-ghost" wx:if="{{contract && !canSign}}" bindtap="openContract">查看合同快照</button></view></view>
    <view class="card" wx:if="{{order.status === 'HOLD' || order.paid_at}}"><view class="card-title">2 · 模拟付款</view><view class="notice {{canPay ? 'notice-warn' : ''}}">{{order.paid_at ? '演示付款结果已保存，当前处理进度见上方。' : canPay ? '当前合同已确认，请继续模拟付款。付款成功后才生成备货任务。' : '先阅读并确认当前合同，再进行模拟付款。'}}</view><view class="tiny" wx:if="{{contract}}">关联 {{contract.code}} · V{{contract.version}}</view><view class="detail-row"><text>租金 + 可退押金</text><text class="detail-value">NOK {{order.rent_nok}} + {{order.deposit_nok}}</text></view><view class="detail-row total"><text>{{order.paid_at ? '当前订单' : '应付'}}合计</text><text class="detail-value">NOK {{order.total_nok}}</text></view><view class="tiny" wx:if="{{paidText}}">记录时间：{{paidText}} · Europe/Oslo</view><view class="simulation">模拟付款，无真实资金流。服务端复核合同、暂留和金额，成功后生成一次备货任务。</view><view class="notice notice-error" wx:if="{{paymentError}}">{{paymentError}}</view><button class="btn" wx:if="{{canPay}}" disabled="{{acting}}" loading="{{acting}}" bindtap="onDemoPay">确认模拟付款 · NOK {{order.total_nok}}</button></view>
    <button class="btn btn-danger" wx:if="{{canCancel}}" disabled="{{acting}}" bindtap="onCancel">取消预约</button>
  </view>

  <view class="overlay" wx:if="{{showContract}}"><view class="contract-dialog"><view class="row"><view><view class="eyebrow">CONTRACT SNAPSHOT</view><view class="card-title">{{contract.code}}</view></view><text class="close" bindtap="closeContract">×</text></view><view class="simulation">此为课程演示合同，本人确认不构成合格电子签章。</view>
    <scroll-view class="contract-scroll" scroll-y="true" lower-threshold="12" bindscrolltolower="onContractBottom">
      <view class="contract-title">租赁双方与取还约定</view><view class="contract-text">顾客：{{contract.snapshot.customer.name}} · 门店：{{contract.snapshot.store}}</view><view class="contract-text">取货 {{pickupText}}，应还 {{returnText}}。本次滑雪水平：{{contract.snapshot.skill}}。</view>
      <view class="contract-text">电话：{{contract.snapshot.customer.phone || '历史未登记'}} · 邮箱：{{contract.snapshot.customer.email || '历史未登记'}}</view><view class="contract-text">地址：{{contract.snapshot.customer.address || '历史未登记'}}</view><view class="contract-text">出生年：{{contract.snapshot.customer.birthYear || '历史未登记'}} · 身高 {{contract.snapshot.customer.heightCm || '—'}} cm · 体重 {{contract.snapshot.customer.weightKg || '—'}} kg · 鞋码 {{contract.snapshot.customer.shoeSize || '—'}}</view><view class="contract-text">经办责任人：{{contract.snapshot.employee.name || '历史未登记'}} · {{contract.snapshot.channel === 'ONLINE_SELF_SERVICE' ? '线上自助' : '门店人工开具'}}</view><view class="tiny">以上为当前合同冻结资料；修改个人资料不会改写此快照。</view>
      <view class="contract-title">装备与价目快照</view><view class="contract-text" wx:for="{{contract.snapshot.lines}}" wx:key="index">{{item.name}} / {{item.size}} ×{{item.qty}} · 租金 NOK {{item.unit_rent_nok * item.qty}} · 押金 NOK {{item.unit_deposit_nok * item.qty}}</view>
      <view class="contract-text">租金 NOK {{contract.snapshot.rentNok}} + 押金 NOK {{contract.snapshot.depositNok}} = 合计 NOK {{contract.snapshot.totalNok}}</view>
      <view class="contract-title">完整条款</view><view class="contract-text terms">{{contract.snapshot.terms}}</view><view class="contract-end">当前版本条款已到底部，请核对后再确认。</view>
    </scroll-view>
    <view wx:if="{{canSign}}"><view class="tiny">{{contractRead ? '已读到当前版本末尾。' : '请滚动阅读完整合同。'}}</view><view class="notice notice-error" wx:if="{{contractError}}">{{contractError}}</view><input class="field-control" maxlength="100" placeholder="填写本人确认姓名" value="{{signedName}}" bindinput="onSignedName"/><checkbox-group bindchange="onContractAccepted"><label class="agree"><checkbox value="yes" checked="{{contractAccepted}}" disabled="{{!contractRead}}" color="#12375f"/><text class="agree-copy">我已阅读当前合同快照并主动确认（课程演示）</text></label></checkbox-group><button class="btn" disabled="{{acting || !contractAccepted}}" bindtap="onSignContract">记录本人演示确认</button></view><button wx:else class="btn btn-ghost" bindtap="closeContract">关闭</button>
  </view></view>
</view>
