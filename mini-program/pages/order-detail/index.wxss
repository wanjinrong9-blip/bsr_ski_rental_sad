.heading-row{margin:18rpx 0}.current-step{background:linear-gradient(125deg,#0d2b54,#24577b);color:#fff;border-radius:18rpx;padding:23rpx;margin-bottom:25rpx}.current-step .eyebrow{color:#b5d7e9}.current-step .muted{color:#d6e8f2}.current-name{font-size:31rpx;font-weight:850;margin:8rpx 0}.timeline{padding-left:13rpx}.step{display:flex;gap:18rpx;border-left:2rpx solid #d8e5ee;margin-left:6rpx;padding:0 0 25rpx 20rpx;position:relative}.step:last-child{border-left-color:transparent}.dot{position:absolute;left:-9rpx;top:2rpx;width:14rpx;height:14rpx;border-radius:999rpx;background:#c7d8e3}.step.done .dot{background:#477fa4}.step.current .dot{background:#c89365;box-shadow:0 0 0 7rpx #fff1e2}.step-body{flex:1;min-width:0}.step-label{font-size:23rpx;font-weight:720;color:#244968}.step-body .tiny{margin-top:6rpx}.detail-row{display:flex;justify-content:space-between;gap:18rpx;font-size:24rpx;margin:15rpx 0;color:#55718a}.detail-value{text-align:right;color:#173e66;font-weight:720}.detail-row.total{font-weight:850;font-size:29rpx;background:#e8f2f7;border-radius:12rpx;padding:14rpx}.pickup-code{font-size:43rpx;font-weight:900;letter-spacing:7rpx;color:#103a63;margin:10rpx 0}.prep-event{display:flex;gap:14rpx;margin:16rpx 0}.event-mark{width:11rpx;height:11rpx;background:#6a9ebc;border-radius:50%;margin-top:10rpx;flex:none}.event-title{font-size:23rpx;font-weight:750;color:#1d486d}.overlay{position:fixed;inset:0;background:rgba(13,42,82,.54);z-index:20;display:flex;align-items:flex-end}.contract-dialog{background:#fff;border-top:8rpx solid #12375f;border-radius:30rpx 30rpx 0 0;width:100%;padding:28rpx 28rpx 55rpx;max-height:89vh}.close{font-size:48rpx;line-height:1;color:#718fa5;padding:0 12rpx}.contract-scroll{height:47vh;border:1rpx solid #dbe7ef;border-radius:16rpx;background:#f9fbfd;padding:0 18rpx;margin:15rpx 0}.contract-title{font-size:27rpx;font-weight:800;color:#153b60;margin:25rpx 0 12rpx}.contract-text{font-size:23rpx;line-height:1.65;color:#4f6b81;margin:10rpx 0}.contract-text.terms{white-space:pre-wrap}.contract-end{background:#e8f2f7;color:#245d7e;padding:18rpx;border-radius:14rpx;margin:25rpx 0}.agree{display:flex;align-items:flex-start;gap:7rpx;font-size:23rpx;margin:17rpx 0}.agree-copy{flex:1}.contract-dialog .btn{width:100%;margin-top:14rpx}

.contract-dialog{overflow-y:auto}
.damage-case{border:1rpx solid #d7e5ed;border-radius:18rpx;background:#f7fbfd;padding:20rpx;margin:18rpx 0}.damage-case .row{align-items:flex-start;gap:14rpx;margin-bottom:10rpx}.damage-name{font-size:25rpx;font-weight:800;color:#173e66;flex:1}.damage-case .pill{font-size:19rpx;white-space:nowrap}.damage-case .tiny{line-height:1.6;margin:8rpx 0}.damage-diagnosis{font-size:22rpx;line-height:1.6;color:#355c76;padding:12rpx 14rpx;background:#eaf3f7;border-left:5rpx solid #73a4bc;border-radius:8rpx;margin:11rpx 0}.damage-contacts .tiny{line-height:1.6;margin:10rpx 0}
.photo-list{display:flex;flex-wrap:wrap;gap:12rpx;margin:12rpx 0}
.photo-button{margin:0;padding:5rpx 16rpx;max-width:100%;min-height:56rpx;line-height:1.5;border:1rpx solid #bed6e3;border-radius:12rpx;background:#eaf4f8;color:#1e5979;font-size:21rpx;text-align:left;white-space:normal;overflow-wrap:anywhere}
.photo-button::after{border:0}
.dispute-note{box-sizing:border-box;width:100%;height:180rpx;margin:18rpx 0}
