page{background:#f2f6f9;color:#132f50;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx}
view,text,button,input,picker,textarea{box-sizing:border-box}
button{font:inherit}
.page{padding:30rpx 28rpx 80rpx}
.brand-mini{display:flex;align-items:center;gap:14rpx;margin:0 0 20rpx;color:#416487;font-size:19rpx;font-weight:800;letter-spacing:3rpx}
.brand-mini-logo{display:block;width:72rpx;height:72rpx;border-radius:15rpx;flex:none}
.eyebrow{color:#417498;font-size:20rpx;font-weight:800;letter-spacing:3rpx}
.title{font-size:48rpx;line-height:1.18;font-weight:850;margin:10rpx 0 12rpx;color:#102d52}
.muted{color:#546e85;font-size:24rpx;line-height:1.55}
.tiny{color:#4f6a82;font-size:21rpx;line-height:1.5}
.card{background:#fff;border:1rpx solid #dce7ef;border-radius:26rpx;box-shadow:0 14rpx 34rpx rgba(17,50,84,.055);padding:28rpx;margin-bottom:22rpx}
.card-title{font-size:31rpx;font-weight:820;margin-bottom:12rpx;color:#132f50}
.section-title{display:flex;align-items:center;justify-content:space-between;margin:36rpx 0 18rpx;gap:12rpx}
.section-title .name{font-size:33rpx;font-weight:820;color:#102d52}
.btn{background:#12375f;color:#fff;border-radius:16rpx;padding:18rpx 26rpx;font-size:26rpx;font-weight:750;line-height:1.5;text-align:center;box-shadow:0 7rpx 16rpx rgba(13,42,82,.12)}
.btn::after{border:none}
.btn[disabled]{background:#b9c9d7;color:#f5f8fb;box-shadow:none}
.btn-ghost{background:#e9f2f7;color:#1d5279;box-shadow:none}
.btn-danger{background:#fff0ea;color:#9a4f43;box-shadow:none}
.btn-small{font-size:23rpx;padding:10rpx 19rpx;border-radius:12rpx}
.row{display:flex;align-items:center;justify-content:space-between;gap:18rpx}
.column{display:flex;flex-direction:column;gap:8rpx}
.field{margin:18rpx 0}
.field-label{display:block;color:#355573;font-size:23rpx;font-weight:720;margin-bottom:10rpx}
.field-control{border:1rpx solid #cfdfea;background:#f9fbfd;border-radius:14rpx;min-height:80rpx;padding:18rpx 20rpx;font-size:27rpx;color:#173a60}
.field-control.placeholder{color:#8da2b2}
.picker-text{display:flex;align-items:center;justify-content:space-between}
.picker-text::after{content:'⌄';color:#537fa0}
.notice{padding:21rpx 23rpx;border-radius:16rpx;background:#eaf3f8;color:#275471;font-size:23rpx;line-height:1.6;margin:18rpx 0}
.notice-warn{background:#fff4e9;color:#875a37}
.notice-error{background:#fff0ed;color:#a15349}
.pill{display:inline-block;border-radius:999rpx;background:#e6f1f7;color:#1f5b7e;font-size:21rpx;font-weight:750;padding:5rpx 14rpx;white-space:nowrap}
.pill-warm{background:#fff0e2;color:#96613b}
.amount{font-size:32rpx;font-weight:850;color:#123d67}
.line{height:1rpx;background:#e0eaf1;margin:18rpx 0}
.empty{padding:60rpx 30rpx;text-align:center;color:#6f879b}
.empty .symbol{font-size:68rpx;color:#9fc4d8;margin-bottom:15rpx}
.empty .heading{font-size:30rpx;font-weight:800;color:#193c61;margin-bottom:10rpx}
.loading{padding:80rpx;text-align:center;color:#6f879b}
.simulation{padding:13rpx 18rpx;background:#e9f0f5;border-radius:13rpx;color:#526e85;font-size:20rpx;line-height:1.5;margin:15rpx 0}
.action-stack{display:flex;flex-direction:column;gap:15rpx;margin-top:22rpx}
.safe-bottom{height:30rpx}
