# Template only. Keep this site disabled until domain, certificate and access gates pass.
# Node listens only on 127.0.0.1:4175; Nginx alone would receive HTTPS traffic.
server {
    listen 443 ssl;
    server_name __SHOWCASE_DOMAIN__;
    ssl_certificate /etc/bsr/tls/fullchain.pem;
    ssl_certificate_key /etc/bsr/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    if ($http_host != "__SHOWCASE_DOMAIN__") { return 421; }
    client_max_body_size 10m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;

    location / {
        proxy_pass http://127.0.0.1:4175;
        proxy_http_version 1.1;
        proxy_set_header Host __SHOWCASE_DOMAIN__;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-BSR-Client-IP $remote_addr;
        # Must contain one proxy_set_header X-BSR-Proxy-Secret line matching
        # the private BSR_PROXY_SECRET in showcase.env.
        include /etc/bsr/proxy-secret-showcase.conf;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header Forwarded "";
        proxy_set_header X-Real-IP "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 3600s;
    }
}
