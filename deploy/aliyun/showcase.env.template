# Template only. Render privately as /etc/bsr/showcase.env (0600).
# Initialize an independent synthetic SHOWCASE database before enabling service.
# Never copy data/bsr.sqlite, Demo123!, actual customers, or secrets into Git.
NODE_ENV=production
BSR_RUN_MODE=showcase
BSR_CANDIDATE_TRANSPORT=trusted-local-proxy
HOST=127.0.0.1
PORT=4175
BSR_PUBLIC_ORIGIN=https://__SHOWCASE_DOMAIN__
BSR_DB_PATH=/srv/bsr/data/showcase.sqlite
BSR_BACKUP_DIR=/srv/bsr/backups
BSR_PROXY_SECRET=__SHOWCASE_PROXY_SECRET__
BSR_MINI_ENTRY_STATE=OFF
# Public AppID wx51ce51fc873371a6 is known. Keep BSR_WECHAT_MINI_ENABLED,
# the private AppSecret and platform access unset until the HTTPS request
# domain, real-platform login and phone acceptance are complete.
