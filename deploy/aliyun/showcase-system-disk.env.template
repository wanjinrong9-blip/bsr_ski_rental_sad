# Template only for the purchased 2 vCPU / 2 GiB / 40 GiB system-disk-only instance.
# Render privately as /etc/bsr/showcase-system-disk.env (0600).
# Do not enable until independent synthetic data, off-host backup and restore
# are verified on the target Ubuntu host. Never copy the local DEMO database.
NODE_ENV=production
BSR_RUN_MODE=showcase
BSR_CANDIDATE_TRANSPORT=trusted-local-proxy
HOST=127.0.0.1
PORT=4175
BSR_PUBLIC_ORIGIN=https://__SHOWCASE_DOMAIN__
BSR_DB_PATH=/var/lib/bsr/data/showcase.sqlite
BSR_BACKUP_DIR=/var/lib/bsr/backups
BSR_PROXY_SECRET=__SHOWCASE_PROXY_SECRET__
BSR_MINI_ENTRY_STATE=OFF
# Public AppID wx51ce51fc873371a6 is known. Keep BSR_WECHAT_MINI_ENABLED,
# the private AppSecret and platform access unset until the HTTPS request
# domain, real-platform login and phone tests pass.
